# Bu faylni .env nomi bilan nusxalab, haqiqiy qiymatlar bilan to'ldiring.
# .env faylini HECH QACHON git'ga qo'shmang (.gitignore'ga qo'shilgan bo'lishi kerak).

DJANGO_SECRET_KEY=shu-yerga-uzun-tasodifiy-maxfiy-kalit-qoying
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.uz,www.yourdomain.uz

# Production uchun PostgreSQL (tavsiya etiladi). Bo'sh qoldirsangiz SQLite ishlatiladi (faqat sinov uchun).
DATABASE_URL=postgres://user:password@localhost:5432/qtyb_care
